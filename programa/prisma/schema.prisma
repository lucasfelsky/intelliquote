generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum QuoteRequestStatus {
  open
  closed
}

enum SupplierStatus {
  active
  inactive
  blocked
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id                     Int                   @id @default(autoincrement())
  name                   String
  email                  String                @unique
  passwordHash           String
  isActive               Boolean               @default(true)
  roleId                 Int
  role                   Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions               Session[]
  createdSuppliers       Supplier[]            @relation("SupplierCreatedBy")
  createdQuoteRequests   QuoteRequest[]        @relation("QuoteRequestCreatedBy")
  createdQuoteResponses  QuoteResponse[]       @relation("QuoteResponseCreatedBy")
  executedComparisons    QuoteComparison[]     @relation("QuoteComparisonExecutedBy")
  approvedComparisons    QuoteComparison[]     @relation("QuoteComparisonApprovedBy")
  auditLogs              AuditLog[]            @relation("AuditPerformedBy")
  uploadedAttachments    Attachment[]          @relation("AttachmentUploadedBy")
  passwordResetTokens    PasswordResetToken[]
  companyProfileUpdates  CompanyProfile[]      @relation("CompanyProfileUpdatedBy")
  emailTemplatesUpdated  EmailTemplate[]       @relation("EmailTemplateUpdatedBy")
  targetPriceHistorySent QuoteResponseTargetPriceHistory[] @relation("TargetPriceHistorySentBy")
  createdDispatchEvents  DispatchEvent[]       @relation("DispatchEventCreatedBy")
  createdPortalTokens    SupplierPortalToken[] @relation("SupplierPortalTokenCreatedBy")
  createdSupplierReviews SupplierReview[]      @relation("SupplierReviewCreatedBy")
  emailSignature         UserEmailSignature?
  createdCreditPartners  CreditPartner[]       @relation("CreditPartnerCreatedBy")
  createdCreditSupportRequests CreditSupportRequest[] @relation("CreditSupportRequestCreatedBy")
  createdForwarders      Forwarder[]           @relation("ForwarderCreatedBy")
  createdSupplierDocuments SupplierDocument[]  @relation("SupplierDocumentCreatedBy")
  commercialRequests     CommercialRequest[]   @relation("CommercialRequestRequestedBy")
  commercialRequestStatusChanges CommercialRequest[] @relation("CommercialRequestStatusChangedBy")
  commercialRequestAttachments CommercialRequestAttachment[] @relation("CommercialRequestAttachmentUploadedBy")
  createdForecastSnapshots ForecastSnapshot[] @relation("ForecastSnapshotCreatedBy")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([roleId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           Int
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Supplier {
  id                Int                      @id @default(autoincrement())
  name              String
  website           String?
  status            SupplierStatus           @default(active)
  country           String?
  notes             String?
  paymentTermsDays  Int                      @default(30)
  createdById       Int?
  acceptedIncoterms Incoterm[]
  // F12 (backlog 2026-07-12): etiquetas livres pra classificar o fornecedor
  // (ex.: "confiavel", "prazo curto"). Exibidas como chips filtraveis.
  tags              String[]                 @default([])
  contacts          SupplierContact[]
  quoteResponses    QuoteResponse[]
  portalTokens      SupplierPortalToken[]
  portalResponses   SupplierPortalResponse[]
  reviews           SupplierReview[]
  families          ItemFamily[]
  creditSupportRequests CreditSupportRequest[]
  documents         SupplierDocument[]
  forecastSources   ForecastSource[]
  createdBy         User?                    @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

// F12 (backlog 2026-07-12): avaliacao do fornecedor vencedor por dimensoes
// (preco / prazo / qualidade, 1..5) + comentario opcional, capturada ao
// concluir a cotacao. 1 review por cotacao (quoteRequestId @unique preserva
// o historico e evita duplicata). A media/contagem sao computadas na leitura
// (SupplierController + /reports/top-suppliers), nao persistidas.
model SupplierReview {
  id             Int          @id @default(autoincrement())
  supplierId     Int
  quoteRequestId Int          @unique
  priceRating    Int
  leadTimeRating Int
  qualityRating  Int
  comment        String?
  createdById    Int?
  createdAt      DateTime     @default(now())
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("SupplierReviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([createdById])
}

model QuoteRequest {
  id              Int                      @id @default(autoincrement())
  requestCode     String                   @unique
  productName     String?
  quantity        Int?
  description     String?
  desiredIncoterm Incoterm[]
  destinationPort String?
  originPort      String?                  @default("Shanghai")
  currency        String                   @default("USD")
  deadlineAt      DateTime?
  status          QuoteRequestStatus       @default(open)
  closedAt        DateTime?
  reopenedAt      DateTime?
  purchaseOrderSentAt DateTime?
  listedAt        DateTime                 @default(now()) // chave de ordenacao da lista; muda so no reopen
  isDevelopment   Boolean                  @default(false) // ligado pelo workflow (solicitacao de desenvolvimento); nunca desligado
  createdById     Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?
  items           QuoteRequestItem[]
  purchaseOrders  QuoteRequestPurchaseOrder[]
  quoteResponses  QuoteResponse[]
  comparisons     QuoteComparison[]
  portalTokens    SupplierPortalToken[]
  portalReminders SupplierPortalReminder[]
  portalResponses SupplierPortalResponse[]
  dispatchEvents  DispatchEvent[]
  review          SupplierReview?
  creditSupportRequests CreditSupportRequest[]
  commercialRequests CommercialRequest[]
  createdBy       User?                    @relation("QuoteRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([deletedAt])
  @@index([listedAt])
}

model QuoteRequestItem {
  id                  Int                          @id @default(autoincrement())
  quoteRequestId      Int
  catalogItemId       Int?
  itemCode            String?
  productName         String
  description         String?
  quantity            Int
  unit                String                       @default("UN")
  desiredIncoterm     Incoterm?
  destinationPort     String?
  targetPrice         Decimal?                     @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  deletedAt           DateTime?
  purchaseOrderId     Int?
  quoteRequest        QuoteRequest                 @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  purchaseOrder       QuoteRequestPurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  catalogItem         CatalogItem?                 @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  portalResponseItems SupplierPortalResponseItem[]
  quoteResponseItems  QuoteResponseItem[]
  creditSupportItems  CreditSupportRequestItem[]
  commercialRequestItems CommercialRequestItem[]

  @@index([quoteRequestId])
  @@index([catalogItemId])
  @@index([deletedAt])
  @@index([purchaseOrderId])
}

model QuoteRequestPurchaseOrder {
  id             Int                @id @default(autoincrement())
  quoteRequestId Int
  label          String
  position       Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  quoteRequest   QuoteRequest       @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  items          QuoteRequestItem[]

  @@index([quoteRequestId, position])
}

model CatalogItem {
  id                Int                @id @default(autoincrement())
  commercialName    String
  marketName        String
  ncm               String?
  dbcorpCode        String?
  /// DEPRECATED: DG agora e informado pelo fornecedor por item da resposta (QuoteResponseItem/SupplierPortalResponseItem). Nao e mais lida nem escrita; DROP em PR futuro de limpeza.
  isDangerousGood   Boolean            @default(false)
  notes             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  quoteRequestItems QuoteRequestItem[]
  commercialRequestItems CommercialRequestItem[]
  forecastCodes     ForecastProductCode[]
  familyId          Int?
  family            ItemFamily?        @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@unique([marketName])
  @@index([marketName])
  @@index([commercialName])
  @@index([isDangerousGood])
  @@index([familyId])
}

model ItemFamily {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     CatalogItem[]
  suppliers Supplier[]
  forecastProducts ForecastProduct[]
}

model QuoteResponse {
  id                Int                     @id @default(autoincrement())
  quoteRequestId    Int
  supplierId        Int
  offeredPrice      Decimal                 @db.Decimal(12, 2)
  targetPrice       Decimal?                @db.Decimal(12, 2)
  currency          String                  @default("USD")
  exchangeRate      Decimal                 @default(1.0) @db.Decimal(14, 6)
  freightCost       Decimal                 @default(0.0) @db.Decimal(14, 2)
  insuranceCost     Decimal                 @default(0.0) @db.Decimal(14, 2)
  otherFees         Decimal                 @default(0.0) @db.Decimal(14, 2)
  importDuty        Decimal                 @default(0.0) @db.Decimal(8, 4)
  ipi               Decimal                 @default(0.0) @db.Decimal(8, 4)
  pis               Decimal                 @default(0.0) @db.Decimal(8, 4)
  cofins            Decimal                 @default(0.0) @db.Decimal(8, 4)
  totalLandedCost   Decimal                 @default(0.0) @db.Decimal(14, 2)
  offeredIncoterm   Incoterm
  paymentTermsDays  Int
  leadTimeDays      Int?
  notes             String?
  // Porto de origem declarado pelo fornecedor (geral da proposta); NULL = nao informado
  originPort        String?
  submittedAt       DateTime                @default(now())
  version           Int                     @default(1)
  isWinner          Boolean                 @default(false)
  createdById       Int?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  quoteRequest      QuoteRequest            @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier          Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy         User?                   @relation("QuoteResponseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comparisonResults QuoteComparisonResult[]
  items             QuoteResponseItem[]
  wonComparisons    QuoteComparison[]       @relation("ComparisonWinner")
  targetPriceHistory QuoteResponseTargetPriceHistory[]
  creditSupportRequests CreditSupportRequest[]
  priceSnapshots QuoteResponsePriceSnapshot[]

  @@unique([quoteRequestId, supplierId])
  @@index([quoteRequestId])
  @@index([supplierId])
  @@index([createdById])
  @@index([deletedAt])
}

model QuoteResponseItem {
  id                 Int       @id @default(autoincrement())
  quoteResponseId    Int
  quoteRequestItemId Int
  unitPrice          Decimal   @db.Decimal(14, 2)
  quantity           Int
  totalPrice         Decimal   @db.Decimal(14, 2)
  leadTimeDays       Int?
  notes              String?
  targetPrice        Decimal?  @db.Decimal(12, 2)
  // [{ incoterm, unitPrice, totalPrice }]; NULL = proposta legada de preco unico
  incotermPrices     Json?
  // Origem informada pelo fornecedor so quando difere da geral; NULL = herda a geral
  originPort         String?
  // Fornecedor marcou 'Temporarily unavailable'; precos/quantidade gravados como 0 e ignorados em somas
  isUnavailable      Boolean   @default(false)
  // Fornecedor marcou o item como Dangerous Goods (checkbox simples; false = nao DG); sempre false se isUnavailable
  isDangerousGood    Boolean   @default(false)
  deletedAt          DateTime?

  quoteResponse    QuoteResponse    @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)
  quoteRequestItem QuoteRequestItem @relation(fields: [quoteRequestItemId], references: [id], onDelete: Cascade)

  @@index([quoteResponseId])
  @@index([quoteRequestItemId])
  @@index([deletedAt])
}

model QuoteComparison {
  id                    Int                     @id @default(autoincrement())
  quoteRequestId        Int
  executedById          Int?
  priceWeight           Int
  paymentTermsWeight    Int
  incotermWeight        Int
  qualityWeight         Int                     @default(0)
  winnerQuoteResponseId Int?
  approvalStatus        String                  @default("not_required")
  approvedById          Int?
  approvedAt            DateTime?
  createdAt             DateTime                @default(now())
  // PR4a: vencedor = alternativa via parceiro (winnerQuoteResponseId continua = resposta de origem)
  winnerCreditSupportRequestId Int?
  quoteRequest          QuoteRequest            @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  executedBy            User?                   @relation("QuoteComparisonExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)
  approvedBy            User?                   @relation("QuoteComparisonApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  winnerQuoteResponse   QuoteResponse?          @relation("ComparisonWinner", fields: [winnerQuoteResponseId], references: [id], onDelete: SetNull)
  results               QuoteComparisonResult[]
  winnerCreditSupportRequest   CreditSupportRequest? @relation("ComparisonCreditWinner", fields: [winnerCreditSupportRequestId], references: [id], onDelete: SetNull)

  @@index([quoteRequestId])
  @@index([executedById])
  @@index([createdAt])
  @@index([winnerCreditSupportRequestId])
}

model QuoteComparisonResult {
  id                Int             @id @default(autoincrement())
  comparisonId      Int
  quoteResponseId   Int?
  supplierId        Int
  offeredPrice      Decimal         @db.Decimal(12, 2)
  offeredIncoterm   Incoterm
  paymentTermsDays  Int
  exchangeRate      Decimal         @db.Decimal(14, 6)
  freightCost       Decimal         @db.Decimal(14, 2)
  insuranceCost     Decimal         @db.Decimal(14, 2)
  otherFees         Decimal         @db.Decimal(14, 2)
  importDutyRate    Decimal         @db.Decimal(8, 4)
  ipiRate           Decimal         @db.Decimal(8, 4)
  pisRate           Decimal         @db.Decimal(8, 4)
  cofinsRate        Decimal         @db.Decimal(8, 4)
  cifValue          Decimal         @db.Decimal(14, 2)
  importDutyAmount  Decimal         @db.Decimal(14, 2)
  ipiAmount         Decimal         @db.Decimal(14, 2)
  pisCofinsAmount   Decimal         @db.Decimal(14, 2)
  totalLandedCost   Decimal         @db.Decimal(14, 2)
  priceScore        Float
  paymentTermsScore Float
  incotermScore     Float
  qualityScore      Float           @default(0)
  totalScore        Float
  isWinner          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  // PR4a: linha = alternativa via parceiro (quoteResponseId/supplierId = resposta de origem)
  creditSupportRequestId Int?
  comparison        QuoteComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  quoteResponse     QuoteResponse?  @relation(fields: [quoteResponseId], references: [id], onDelete: SetNull)
  creditSupportRequest   CreditSupportRequest? @relation(fields: [creditSupportRequestId], references: [id], onDelete: SetNull)

  @@index([comparisonId])
  @@index([quoteResponseId])
  @@index([supplierId])
  @@index([creditSupportRequestId])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  entityType    String
  entityId      String
  action        String
  performedById Int?
  beforeData    Json?
  afterData     Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  performedBy   User?    @relation("AuditPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([performedById])
  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
}

model SupplierContact {
  id              Int                      @id @default(autoincrement())
  supplierId      Int
  name            String
  email           String
  phone           String?
  position        String?
  isPrimary       Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  supplier        Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  portalTokens    SupplierPortalToken[]
  portalReminders SupplierPortalReminder[]
  portalResponses SupplierPortalResponse[]

  @@index([supplierId])
  @@index([supplierId, isPrimary])
}

model CreditPartner {
  id          Int                    @id @default(autoincrement())
  name        String
  taxId       String?
  website     String?
  country     String?
  notes       String?
  isActive    Boolean                @default(true)
  createdById Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?
  contacts    CreditPartnerContact[]
  supportRequests CreditSupportRequest[]
  createdBy   User?                  @relation("CreditPartnerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([createdById])
  @@index([deletedAt])
}

model CreditPartnerContact {
  id              Int           @id @default(autoincrement())
  creditPartnerId Int
  name            String
  email           String
  phone           String?
  position        String?
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  creditPartner   CreditPartner @relation(fields: [creditPartnerId], references: [id], onDelete: Cascade)
  supportRequests CreditSupportRequest[]

  @@index([creditPartnerId])
}

model Forwarder {
  id          Int                @id @default(autoincrement())
  companyName String
  address     String?
  website     String?
  notes       String?
  isActive    Boolean            @default(true)
  isDefault   Boolean            @default(false)
  createdById Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  contacts    ForwarderContact[]
  createdBy   User?              @relation("ForwarderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([isDefault])
  @@index([createdById])
  @@index([deletedAt])
}

model ForwarderContact {
  id          Int       @id @default(autoincrement())
  forwarderId Int
  name        String
  email       String?
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  forwarder   Forwarder @relation(fields: [forwarderId], references: [id], onDelete: Cascade)

  @@index([forwarderId])
}

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  entityType   String
  entityId     String
  uploadedById Int?
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityId, entityType])
  @@index([uploadedById])
}

// =================== Supplier Portal (magic-link flow) ===================

enum MailLogStatus {
  queued
  sent
  failed
  bounced
  suppressed
}

model CompanyProfile {
  id              Int      @id @default(autoincrement())
  companyName     String   @default("SQ Quimica")
  tradeName       String?
  taxId           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String   @default("Brazil")
  purchasingEmail String?
  purchasingPhone String?
  website         String?
  logoUrl         String?
  awardApprovalThreshold Decimal? @db.Decimal(14,2)
  // Lista de e-mails fixos em copia automatica em TODOS os envios de
  // cotacao desta empresa. O DispatchController sempre mescla essa
  // lista com os recipients selecionados no modal (nunca substitui,
  // dedup case-insensitive). Persistido como JSON array de strings.
  dispatchCc      String   @default("[]")
  // Destinatarios do aviso "nova solicitacao do comercial". Preenchida: o aviso
  // vai SO para ela. Vazia: cai em INTELLIQUOTE_COMEX_CC_LIST + dispatchCc.
  // Persistido como JSON array de strings (mesmo formato do dispatchCc).
  commercialRequestNotifyEmails String @default("[]")
  updatedAt       DateTime @updatedAt
  updatedById     Int?
  updatedBy       User?    @relation("CompanyProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model DispatchEvent {
  id              Int                   @id @default(autoincrement())
  quoteRequestId  Int
  createdById     Int
  recipientsCount Int
  subject         String
  ccList          String?
  locale          String                @default("en")
  status          String                @default("completed")
  createdAt       DateTime              @default(now())
  quoteRequest    QuoteRequest          @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("DispatchEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tokens          SupplierPortalToken[]

  @@index([quoteRequestId])
  @@index([createdById])
  @@index([createdAt])
}

model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String
  locale      String   @default("en")
  subject     String
  htmlBody    String
  textBody    String
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById Int?
  updatedBy   User?    @relation("EmailTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([key, locale])
  @@index([key])
}

// Assinatura de e-mail por usuario (usada no e-mail da Ordem de Compra).
// Tabela propria (e nao colunas em User) porque AuthService le o User inteiro
// em toda request autenticada -- um bytea ali seria carregado o tempo todo.
model UserEmailSignature {
  userId        Int      @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          String?
  imageData     Bytes?
  imageMimeType String?
  imageWidth    Int?
  imageHeight   Int?
  imageSize     Int?
  updatedAt     DateTime @updatedAt
}

model SupplierPortalToken {
  id                Int                              @id @default(autoincrement())
  quoteRequestId    Int
  supplierId        Int
  supplierContactId Int
  tokenHash         String                           @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  firstSeenAt       DateTime?
  lastSeenAt        DateTime?
  accessCount       Int                              @default(0)
  respondedAt       DateTime?
  // Setado no token emitido por um lembrete; informativo, nao participa da
  // selecao (a idempotencia do lembrete diario e' SupplierPortalReminder).
  reminderSentAt    DateTime?
  responseId        Int?                             @unique
  createdById       Int
  dispatchEventId   Int?
  createdAt         DateTime                         @default(now())
  quoteRequest      QuoteRequest                     @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier          Supplier                         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierContact   SupplierContact                  @relation(fields: [supplierContactId], references: [id], onDelete: Cascade)
  createdBy         User                             @relation("SupplierPortalTokenCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dispatchEvent     DispatchEvent?                   @relation(fields: [dispatchEventId], references: [id], onDelete: SetNull)
  response          SupplierPortalResponse?          @relation("SupplierPortalTokenResponse")
  revisions         SupplierPortalResponseRevision[] @relation("SupplierPortalTokenRevisions")
  logs              SupplierPortalTokenLog[]

  @@index([quoteRequestId])
  @@index([supplierId])
  @@index([supplierContactId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([respondedAt])
  @@index([dispatchEventId])
}

model SupplierPortalResponse {
  id                 Int                          @id @default(autoincrement())
  portalTokenId      Int                          @unique
  quoteRequestId     Int
  supplierId         Int
  supplierContactId  Int
  currency           String                       @default("USD")
  incoterm           Incoterm
  paymentTermsDays   Int                          @default(30)
  totalPrice         Decimal                      @db.Decimal(14, 2)
  totalPriceCurrency String                       @default("USD")
  validityDays       Int                          @default(30)
  notes              String?
  // Porto de origem geral declarado pelo fornecedor; NULL = nao informado
  originPort         String?
  // Versao da resposta corrente. Cada revisao do fornecedor incrementa este
  // contador; as versoes anteriores ficam preservadas (read-only) em
  // SupplierPortalResponseRevision.
  version            Int                          @default(1)
  submittedAt        DateTime                     @default(now())
  submitterIp        String?
  submitterUserAgent String?
  deletedAt          DateTime?
  portalToken        SupplierPortalToken          @relation("SupplierPortalTokenResponse", fields: [portalTokenId], references: [id], onDelete: Cascade)
  quoteRequest       QuoteRequest                 @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier           Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierContact    SupplierContact              @relation(fields: [supplierContactId], references: [id], onDelete: Cascade)
  items              SupplierPortalResponseItem[]

  @@index([quoteRequestId])
  @@index([supplierId])
  @@index([supplierContactId])
  @@index([deletedAt])
}

// Historico append-only de versoes anteriores de uma resposta do portal.
// Sempre que o fornecedor revisa o preco (antes do link expirar), a resposta
// corrente e' fotografada aqui (com os itens serializados em JSON) e a
// SupplierPortalResponse "atual" e' sobrescrita com a nova versao. Assim o
// fornecedor continua enxergando o que ja enviou, sem duplicar a relacao 1:1
// entre token e resposta corrente.
model SupplierPortalResponseRevision {
  id                 Int                 @id @default(autoincrement())
  portalTokenId      Int
  version            Int
  currency           String
  incoterm           Incoterm
  paymentTermsDays   Int
  totalPrice         Decimal             @db.Decimal(14, 2)
  totalPriceCurrency String
  validityDays       Int
  notes              String?
  originPort         String?
  // [{ quoteRequestItemId, unitPrice, quantity, totalPrice, leadTimeDays, notes, originPort, isUnavailable, isDangerousGood }] (revisoes antigas sem isDangerousGood = false)
  items              Json
  submittedAt        DateTime
  supersededAt       DateTime            @default(now())
  portalToken        SupplierPortalToken @relation("SupplierPortalTokenRevisions", fields: [portalTokenId], references: [id], onDelete: Cascade)

  @@index([portalTokenId])
  @@index([supersededAt])
}

model SupplierPortalResponseItem {
  id                 Int                    @id @default(autoincrement())
  responseId         Int
  quoteRequestItemId Int
  unitPrice          Decimal                @db.Decimal(14, 2)
  quantity           Int
  totalPrice         Decimal                @db.Decimal(14, 2)
  leadTimeDays       Int?
  notes              String?
  // [{ incoterm, unitPrice, totalPrice }]; NULL = proposta legada de preco unico
  incotermPrices     Json?
  // Origem informada pelo fornecedor so quando difere da geral; NULL = herda a geral
  originPort         String?
  // Fornecedor marcou 'Temporarily unavailable'; precos/quantidade gravados como 0 e ignorados em somas
  isUnavailable      Boolean                @default(false)
  // Fornecedor marcou o item como Dangerous Goods (checkbox simples; false = nao DG); sempre false se isUnavailable
  isDangerousGood    Boolean                @default(false)
  deletedAt          DateTime?
  response           SupplierPortalResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  quoteRequestItem   QuoteRequestItem       @relation(fields: [quoteRequestItemId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([quoteRequestItemId])
  @@index([deletedAt])
}

model SupplierPortalTokenLog {
  id         Int                 @id @default(autoincrement())
  tokenId    Int?
  kind       String
  ip         String?
  userAgent  String?
  meta       Json?
  occurredAt DateTime            @default(now())
  creditSupportRequestId Int?
  token      SupplierPortalToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  creditSupportRequest CreditSupportRequest? @relation(fields: [creditSupportRequestId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([occurredAt])
  @@index([kind])
  @@index([creditSupportRequestId])
}

// Lembrete diario ao fornecedor (claim unico por cotacao/contato/dia BRT).
model SupplierPortalReminder {
  id                Int             @id @default(autoincrement())
  quoteRequestId    Int
  supplierContactId Int
  reminderDate      String          // YYYY-MM-DD no calendario de America/Sao_Paulo
  tokenId           Int             // token ativo de origem (sem FK: historico)
  freshTokenId      Int?            // token emitido para o e-mail (sem FK: historico)
  status            String          @default("claimed") // claimed | sent | failed | suppressed | skipped
  errorMessage      String?
  createdAt         DateTime        @default(now())
  sentAt            DateTime?
  quoteRequest      QuoteRequest    @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplierContact   SupplierContact @relation(fields: [supplierContactId], references: [id], onDelete: Cascade)

  @@unique([quoteRequestId, supplierContactId, reminderDate], map: "SupplierPortalReminder_qr_contact_date_key")
  @@index([reminderDate])
  @@index([supplierContactId])
}

// Lembrete diario: claim por ENDERECO de e-mail/dia (garante 1 e-mail por endereco por dia
// util mesmo com sweeps concorrentes). So o sha256 de lower(trim(email)): nunca o e-mail cru.
model SupplierPortalReminderAddress {
  id           Int      @id @default(autoincrement())
  addressHash  String   // sha256 hex de lower(trim(email))
  reminderDate String   // YYYY-MM-DD no calendario de America/Sao_Paulo
  status       String   @default("claimed") // claimed | sent | failed | skipped
  createdAt    DateTime @default(now())

  @@unique([addressHash, reminderDate])
  @@index([reminderDate])
}

// Credit Support (PR2a): encaminhamento da proposta do fornecedor a um parceiro de credito.
// Snapshot CONGELADO no envio; so o hash do token e persistido (o bruto vive apenas na resposta
// HTTP ao comprador). Sem soft-delete: ciclo de vida = revokedAt/expiresAt.
model CreditSupportRequest {
  id                       Int       @id @default(autoincrement())
  quoteRequestId           Int
  quoteResponseId          Int
  supplierId               Int
  creditPartnerId          Int
  creditPartnerContactId   Int?
  recipientEmails          String    @default("[]")
  emailSubject             String
  emailMessage             String?
  tokenHash                String    @unique
  expiresAt                DateTime
  revokedAt                DateTime?
  firstSeenAt              DateTime?
  lastSeenAt               DateTime?
  accessCount              Int       @default(0)
  sourceResponseVersion    Int
  currency                 String
  offeredIncoterm          Incoterm
  originalPaymentTermsDays Int
  originalTotalPrice       Decimal   @db.Decimal(14, 2)
  originPort               String?
  respondedAt              DateTime?
  responseVersion          Int       @default(0)
  partnerPaymentTermsDays  Int?
  partnerValidityDays      Int?
  partnerNotes             String?
  partnerTotalPrice        Decimal?  @db.Decimal(14, 2)
  submitterIp              String?
  submitterUserAgent       String?
  createdById              Int
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  // PR4a: alternativa via parceiro vencedora da Comparacao (exclusivo com QuoteResponse.isWinner)
  isWinner                 Boolean   @default(false)
  quoteRequest             QuoteRequest             @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteResponse            QuoteResponse            @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)
  supplier                 Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  creditPartner            CreditPartner            @relation(fields: [creditPartnerId], references: [id], onDelete: Restrict)
  creditPartnerContact     CreditPartnerContact?    @relation(fields: [creditPartnerContactId], references: [id], onDelete: SetNull)
  createdBy                User                     @relation("CreditSupportRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items                    CreditSupportRequestItem[]
  logs                     SupplierPortalTokenLog[]
  wonComparisons           QuoteComparison[]        @relation("ComparisonCreditWinner")
  comparisonResults        QuoteComparisonResult[]

  @@index([quoteRequestId])
  @@index([quoteResponseId])
  @@index([creditPartnerId])
  @@index([creditPartnerContactId])
  @@index([createdById])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([quoteRequestId, isWinner])
}

model CreditSupportRequestItem {
  id                 Int       @id @default(autoincrement())
  requestId          Int
  quoteRequestItemId Int
  position           Int
  productName        String
  itemCode           String?
  unit               String
  quantity           Int
  originalUnitPrice  Decimal   @db.Decimal(14, 2)
  originalTotalPrice Decimal   @db.Decimal(14, 2)
  isUnavailable      Boolean   @default(false)
  originPort         String?
  isDangerousGood    Boolean   @default(false)
  partnerUnitPrice   Decimal?  @db.Decimal(14, 2)
  partnerTotalPrice  Decimal?  @db.Decimal(14, 2)
  request            CreditSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteRequestItem   QuoteRequestItem     @relation(fields: [quoteRequestItemId], references: [id], onDelete: Cascade)

  @@unique([requestId, quoteRequestItemId])
  @@index([quoteRequestItemId])
}

model MailLog {
  id                Int           @id @default(autoincrement())
  provider          String
  providerMessageId String?
  fromAddress       String
  toEmail           String
  toName            String?
  ccList            String?
  subject           String
  templateId        String?
  templateVars      Json?
  status            MailLogStatus @default(queued)
  sentAt            DateTime?
  errorMessage      String?
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime      @default(now())

  @@index([status])
  @@index([provider])
  @@index([relatedEntityType, relatedEntityId])
  @@index([toEmail])
  @@index([createdAt])
}

model ExchangeRate {
  id            Int      @id @default(autoincrement())
  currency      String
  rateToBrl     Decimal  @db.Decimal(14, 6)
  referenceDate DateTime @db.Date
  fetchedAt     DateTime @default(now())
  source        String   @default("BCB_PTAX")

  @@unique([currency, referenceDate])
  @@index([currency])
  @@index([fetchedAt])
}

model QuoteResponseTargetPriceHistory {
  id              Int           @id @default(autoincrement())
  quoteResponseId Int
  targetPrice     Decimal       @db.Decimal(12, 2)
  sentById        Int?
  sentAt          DateTime      @default(now())
  quoteResponse   QuoteResponse @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)
  sentBy          User?         @relation("TargetPriceHistorySentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([quoteResponseId])
  @@index([sentAt])
}

// Historico append-only de preco por resposta do fornecedor (botao "Historico" na aba Respostas).
// Uma linha por versao em que algo de preco mudou (unitPrice, quantity, isUnavailable, currency,
// offeredIncoterm, incotermPrices, offeredPrice). Gravada na MESMA transacao da escrita.
// Sem soft-delete (cascade com a resposta). Autor denormalizado: nao referencia User/SupplierContact.
model QuoteResponsePriceSnapshot {
  id                Int           @id @default(autoincrement())
  quoteResponseId   Int
  // 'portal' | 'manual'
  source            String
  performedById     Int?
  supplierContactId Int?
  // Nome do usuario (manual) ou "Nome <email>" do contato (portal); null quando nao resolvido
  actorName         String?
  currency          String
  offeredIncoterm   Incoterm
  offeredPrice      Decimal       @db.Decimal(14, 2)
  // [{ quoteRequestItemId, unitPrice: "10.00", quantity, totalPrice: "100.00", isUnavailable, incotermPrices }]
  // ([] = resposta legada sem itens). Mesmo formato de SupplierPortalResponseRevision.items.
  items             Json
  recordedAt        DateTime      @default(now())
  quoteResponse     QuoteResponse @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)

  @@index([quoteResponseId, recordedAt])
}

// Documentos do fornecedor com data de vencimento (licencas, certificados, etc.).
// expiresOn e o ULTIMO dia valido (@db.Date, meia-noite UTC). Soft-delete via deletedAt
// (os bytes ficam guardados). alertCycle e incrementado sempre que expiresOn muda de fato
// (renovacao) e reinicia os marcos de aviso do PR2.
model SupplierDocument {
  id          Int                   @id @default(autoincrement())
  supplierId  Int
  name        String
  expiresOn   DateTime              @db.Date
  notes       String?
  fileName    String
  mimeType    String
  fileSize    Int
  alertCycle  Int                   @default(1)
  createdById Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?
  supplier    Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("SupplierDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  file        SupplierDocumentFile?
  alerts      SupplierDocumentAlert[]

  @@index([supplierId])
  @@index([expiresOn])
  @@index([createdById])
  @@index([deletedAt])
}

// Binario em tabela separada para nao carregar bytea em toda leitura (mesma ideia de
// UserEmailSignature.imageData).
model SupplierDocumentFile {
  documentId Int              @id
  data       Bytes
  document   SupplierDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// PR2 documentos: idempotencia dos avisos de vencimento. 1 linha por
// (documento, ciclo, marco); claim por create (P2002 = outra execucao ja pegou).
// milestone: D30 | D15 | D7 | D0 | EXPIRED. status: claimed | sent.
// runId liga os claims de uma execucao ao MailLog (relatedEntityId).
model SupplierDocumentAlert {
  id         Int              @id @default(autoincrement())
  documentId Int
  alertCycle Int
  milestone  String
  status     String           @default("claimed")
  runId      String
  claimedAt  DateTime         @default(now())
  sentAt     DateTime?
  document   SupplierDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, alertCycle, milestone])
  @@index([status, claimedAt])
  @@index([runId])
}

enum CommercialRequestStatus {
  pending
  quoting
  fulfilled
  rejected
}

model CommercialRequest {
  id                Int                     @id @default(autoincrement())
  requestedById     Int
  customerName      String?
  notes             String?
  status            CommercialRequestStatus @default(pending)
  rejectionReason   String?
  fulfillmentNote   String?
  statusChangedById Int?
  statusChangedAt   DateTime?
  quoteRequestId    Int?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  requestedBy       User                    @relation("CommercialRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  statusChangedBy   User?                   @relation("CommercialRequestStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  quoteRequest      QuoteRequest?           @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  // Gravado no create (ha item novo sem catalogo); e historico, nunca recalculado.
  isDevelopment     Boolean                 @default(false)
  items             CommercialRequestItem[]
  attachments       CommercialRequestAttachment[]

  @@index([requestedById, createdAt])
  @@index([status, createdAt])
  @@index([quoteRequestId])
}

// Item de catalogo (catalogItemId) OU item novo digitado pelo comercial (proposedName, ainda sem
// catalogo; a Comex vincula antes de cotar). O indice unico PARCIAL
// (commercialRequestId, proposedNameKey) WHERE proposedNameKey IS NOT NULL e o CHECK
// "catalogItemId IS NOT NULL OR proposedName IS NOT NULL" vivem so na migration (Prisma nao
// representa); precedente: SupplierContact_single_primary_per_supplier.
model CommercialRequestItem {
  id                  Int               @id @default(autoincrement())
  commercialRequestId Int
  catalogItemId       Int?
  proposedName        String?
  proposedNameKey     String?
  notes               String?
  quantity            Int
  unit                String
  targetPrice         Decimal?          @db.Decimal(12, 2)
  targetCurrency      String?
  quoteRequestItemId  Int?
  createdAt           DateTime          @default(now())
  commercialRequest   CommercialRequest @relation(fields: [commercialRequestId], references: [id], onDelete: Cascade)
  catalogItem         CatalogItem?      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  quoteRequestItem    QuoteRequestItem? @relation(fields: [quoteRequestItemId], references: [id], onDelete: SetNull)

  @@unique([commercialRequestId, catalogItemId])
  @@index([catalogItemId])
  @@index([quoteRequestItemId])
}

// Anexos tecnicos (TDS/MSDS/Outro) de solicitacao de desenvolvimento. Bytes em tabela separada.
// kind: TDS | MSDS | OUTRO (CHECK so na migration).
model CommercialRequestAttachment {
  id                  Int                              @id @default(autoincrement())
  commercialRequestId Int
  kind                String
  fileName            String
  mimeType            String
  fileSize            Int
  sha256              String
  uploadedById        Int?
  createdAt           DateTime                         @default(now())
  commercialRequest   CommercialRequest                @relation(fields: [commercialRequestId], references: [id], onDelete: Cascade)
  uploadedBy          User?                            @relation("CommercialRequestAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  file                CommercialRequestAttachmentFile?

  @@unique([commercialRequestId, sha256])
  @@index([commercialRequestId])
  @@index([uploadedById])
}

// Binario em tabela separada: a lista nunca carrega bytea (mesmo padrao de SupplierDocumentFile).
model CommercialRequestAttachmentFile {
  attachmentId Int                         @id
  data         Bytes
  attachment   CommercialRequestAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

// Forecast de compras (Fase 1, PO.COMP.01 Rev.03). "Fonte" e a chave de lead time da aba LEADTIME
// (cadastro proprio; o vinculo com Supplier e opcional). Total = leadTimeDays (coluna G); null = sem
// lead time -> seguranca/demanda/chegada ficam vazios no motor.
model ForecastSource {
  id                       Int               @id @default(autoincrement())
  name                     String
  normalizedName           String            @unique
  readinessDays            Int?
  holidaysDays             Int?
  shippingDays             Int?
  transitDays              Int?
  clearanceDays            Int?
  leadTimeDays             Int?
  // Dias de DATA PRONTIDAO / ETD ate a chegada usados na estimativa do FUP; null = padrao 35. Editado no resumo da
  // importacao DBCorp (o import da planilha nao mexe nestas colunas).
  arrivalFromReadinessDays Int?
  arrivalFromEtdDays       Int?
  // Pais da fonte (ISO 3166-1 alfa-2 maiusculo), informado a mao; casa com as ocasioes de escopo 'pais'. O import da planilha nao grava.
  countryCode              String?
  supplierId               Int?
  supplier                 Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  isActive                 Boolean           @default(true)
  products                 ForecastProduct[]
  leadTimeEvents           ForecastLeadTimeEvent[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([supplierId])
}

model ForecastProduct {
  id                Int                   @id @default(autoincrement())
  name              String
  normalizedName    String                @unique
  sheetOrder        Int?
  sourceId          Int?
  source            ForecastSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  notes             String?
  fixedPriceFlag    Boolean               @default(false)
  fixedPrice        Decimal?              @db.Decimal(14, 4)
  packaging         String?
  noFractioning     Boolean               @default(false)
  sampleQty         String?
  sampleRequestNote String?
  familyId          Int?
  family            ItemFamily?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  isActive          Boolean               @default(true)
  // Quem cadastrou: 'planilha' (import PO.COMP.01) ou 'dbcorp' (tela, a partir de um pendente de cadastro). O import da planilha nao inativa produto 'dbcorp'.
  origin            String                @default("planilha")
  // Compra sob demanda (PR 6a): o item so e comprado quando o cliente envia a programacao; sai da lista de compra do
  // relatorio. Fora das colunas que o import da planilha grava, entao a reimportacao nao sobrescreve.
  purchaseOnDemand     Boolean            @default(false)
  purchaseOnDemandNote String?
  codes             ForecastProductCode[]
  atypicalMonths    ForecastAtypicalMonth[]
  commercialDemands ForecastCommercialDemand[]
  purchaseDecisions ForecastPurchaseDecision[]
  // Grupo de equivalencia (PR 6b): produtos que sao o MESMO material (nomes ou fontes diferentes) tem o estoque avaliado
  // somado no relatorio. Uma coluna garante 1 grupo por produto; fora das colunas que o import da planilha e o cadastro
  // pela tela gravam, entao nenhum deles apaga o vinculo.
  equivalenceGroupId Int?
  equivalenceGroup   ForecastEquivalenceGroup? @relation("ForecastEquivalenceMembers", fields: [equivalenceGroupId], references: [id], onDelete: SetNull)
  principalOfGroups  ForecastEquivalenceGroup[] @relation("ForecastEquivalencePrincipal")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([sourceId])
  @@index([familyId])
  @@index([equivalenceGroupId])
}

// Grupo de equivalencia de produtos (PR 6b): o relatorio de compras soma estoque, chegadas, programacoes, medias e a
// seguranca de cada membro e compra pelo produto PRINCIPAL (quando nulo, o membro de maior media da quinzena). Lido do
// cadastro ATUAL (nao congelado na quinzena). Desfazer o grupo e DELETE: os membros voltam a avulsos (SetNull) e o
// AuditLog guarda os ids. `createdById` sem FK: o autor fica no AuditLog.
model ForecastEquivalenceGroup {
  id                 Int               @id @default(autoincrement())
  name               String
  normalizedName     String            @unique
  notes              String?
  principalProductId Int?
  principalProduct   ForecastProduct?  @relation("ForecastEquivalencePrincipal", fields: [principalProductId], references: [id], onDelete: SetNull)
  members            ForecastProduct[] @relation("ForecastEquivalenceMembers")
  createdById        Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([principalProductId])
}

// Mes de venda atipica de um produto (PR 6c): fica FORA das medias trimestral/semestral (o motor divide pelos meses
// restantes). Vale em toda quinzena cuja janela de vendas contem o mes e e lida do cadastro ATUAL (nao congelada na
// quinzena). `yearMonth` = 'YYYY-MM'. `createdById` sem FK: o autor fica no AuditLog. Hard delete (substituicao do conjunto).
model ForecastAtypicalMonth {
  id          Int             @id @default(autoincrement())
  productId   Int
  product     ForecastProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  yearMonth   String
  reason      String
  createdById Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([productId, yearMonth])
}

// Demanda do comercial (PR 6d): compra pedida pelo comercial por uma programacao futura de cliente FORA do horizonte do
// Forecast (lancada a mao pelo COMEX). So soma ao relatorio de compras quando a necessidade e POSTERIOR ao ultimo mes de
// programacao do DBCorp. `status`: 'aberta' | 'comprada' | 'cancelada' | 'virou_programacao' (String + Zod, sem enum);
// fechada nao reabre. `neededBy` = data de necessidade (date). `commercialRequestId` e so o numero da Solicitacao
// do IntelliQuote para rastreio: sem FK (o modulo de Solicitacoes nao e tocado). `createdById`/`closedById` sem FK:
// o autor fica no AuditLog. `customerName` e dado comercial: nunca vai para log nem para o AuditLog.
model ForecastCommercialDemand {
  id                  Int             @id @default(autoincrement())
  productId           Int
  product             ForecastProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityKg          Decimal         @db.Decimal(18, 6)
  neededBy            DateTime        @db.Date
  reason              String
  customerName        String?
  commercialRequestId Int?
  status              String          @default("aberta")
  closeNote           String?
  closedAt            DateTime?
  closedById          Int?
  createdById         Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status, neededBy])
  @@index([productId, status])
  @@index([commercialRequestId])
}

// Ate 7 codigos DBCorp por produto (EMB.1..EMB.7 = position 1..7). Codigo em maiusculas.
// Cada codigo e uma embalagem (EMB.1..EMB.7); a quantidade/rotulo/principal ficam nas colunas packaging*.
model ForecastProductCode {
  id                 Int             @id @default(autoincrement())
  productId          Int
  product            ForecastProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  position           Int
  code               String          @unique
  catalogItemId      Int?
  catalogItem        CatalogItem?    @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  // Quantidade de UMA embalagem do codigo, em kg (nulo = sem embalagem). 18,6 = precisao de TbEmbalagemItem.EmbalagemQuant (DBCorp).
  packagingQtyKg     Decimal?        @db.Decimal(18, 6)
  // kg de UM pallet fechado desta embalagem (1o tamanho; ex.: 24 bombonas de 25 kg = 600); nulo = sem pallet. Multiplo da quantidade.
  packagingPalletKg  Decimal?        @db.Decimal(18, 6)
  // Tamanhos de pallet ALEM do primeiro (packagingPalletKg), em kg, na ordem do cadastro; vazio = 0 ou 1 tamanho.
  packagingPalletExtraKg Decimal[]   @default([]) @db.Decimal(18, 6)
  packagingLabel     String?
  // Embalagem principal do PRODUTO.
  // Indice unico parcial (so na migration): no maximo uma packagingIsPrimary = true por productId.
  packagingIsPrimary Boolean         @default(false)
  // Quem gravou por ultimo: 'manual' (tela) ou 'dbcorp' (gateway futuro). Nulo = nunca gravado.
  packagingSource    String?
  packagingUpdatedAt DateTime?

  @@unique([productId, position])
  @@index([catalogItemId])
}

// Historico mensal de vendas POR CODIGO (a soma por codigo reproduz as colunas J..O da planilha).
model ForecastMonthlySale {
  id          Int               @id @default(autoincrement())
  code        String
  yearMonth   String
  quantity    Decimal           @db.Decimal(18, 6)
  sourceLabel String
  snapshotId  Int?
  snapshot    ForecastSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([code, yearMonth])
  @@index([yearMonth])
}

// Quinzena (snapshot congelado das entradas). label unico entre nao-deletados e garantido no service
// (Prisma nao expressa unique parcial).
model ForecastSnapshot {
  id          Int                   @id @default(autoincrement())
  label       String
  baseDate    DateTime              @db.Date
  half        Int
  origin      String
  months      Json
  products    Json
  inputs      Json
  expected    Json?
  files       Json
  createdById Int?
  createdBy   User?                 @relation("ForecastSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  deletedAt   DateTime?
  sales       ForecastMonthlySale[]
  purchaseDecisions ForecastPurchaseDecision[]

  @@index([baseDate])
  @@index([deletedAt])
}

// Quantidade decidida de compra por item e quinzena (PR3 do piloto do Forecast; coluna AO "ANALISE FORECAST" da planilha).
// Chave (quinzena, produto); quantityKg >= 0 (0 = decidiu nao comprar). `suggestedKg` (Qtd. final do relatorio) e `demandKg`
// (AN do motor, sinal da planilha: <= 0 = falta) sao CONGELADOS ao criar e a cada mudanca de quantidade (o backtest nao
// depende do cadastro atual). `status` = vocabulario da cor do item na planilha (nao/cotando/preco/confirmado/po): String +
// Zod, sem enum, como ForecastCommercialDemand. `note` e texto livre: nunca vai ao AuditLog. FKs Restrict: excluir a
// quinzena e soft delete (a decisao fica); nenhum fluxo apaga quinzena ou produto fisicamente. `decidedById` sem FK: o
// autor fica no AuditLog.
model ForecastPurchaseDecision {
  id          Int              @id @default(autoincrement())
  snapshotId  Int
  snapshot    ForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  productId   Int
  product     ForecastProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityKg  Decimal          @db.Decimal(18, 6)
  status      String           @default("nao")
  note        String?
  suggestedKg Decimal          @db.Decimal(18, 6)
  demandKg    Decimal          @db.Decimal(18, 6)
  decidedById Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([snapshotId, productId])
  @@index([productId])
}

// Ocasiao que afeta o lead time (feriado, greve, fechamento de porto, safra): periodo + alcance (global, pais ou fonte) +
// etapa (prontidao/embarque/transito/liberacao ou total) + efeito (dias ou percentual). String + Zod, sem enum, como o resto
// do Forecast. Por ora so INFORMA no relatorio (nao muda o motor). `name`/`notes` sao texto livre: nunca vao ao AuditLog.
// `createdById` sem FK: o autor fica no AuditLog. `coverWithStock` so sera usada na fase 5 (nao exposta na API).
// Hard delete (o caminho normal e inativar); apagar a fonte apaga as ocasioes dela (Cascade).
model ForecastLeadTimeEvent {
  id             Int             @id @default(autoincrement())
  name           String
  scopeType      String
  countryCode    String?
  sourceId       Int?
  source         ForecastSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startDate      DateTime        @db.Date
  endDate        DateTime        @db.Date
  recurrence     String          @default("nenhuma")
  component      String          @default("total")
  effectKind     String          @default("dias")
  effectValue    Decimal         @db.Decimal(8, 2)
  coverWithStock Boolean         @default(false)
  notes          String?
  isActive       Boolean         @default(true)
  createdById    Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isActive, startDate])
  @@index([sourceId])
  @@index([scopeType, countryCode])
}
